pipeline {
    agent {
        label 'arseniy-agent' 
    }

    options {
        // ✅ Включаем поддержку ANSI-цветов для всего пайплайна
        ansiColor('xterm')
    }
    
    environment {
        OS_CREDENTIALS_ID = 'rc-credentials-arseniy'
        HEAT_STACK_NAME = "currency-converter-bot-infra"
        HEAT_TEMPLATE = 'heat/deploy-infra.yaml'
    }
    
    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }
        
        stage('Prepare OpenStack Env') {
            steps {
                ansiColor('xterm') {
                    withCredentials([string(credentialsId: OS_CREDENTIALS_ID, variable: 'RC_CONTENT')]) {
                        sh '''
                            set -eu

                            printf '\\033[36m🔐 Loading OpenStack credentials...\\033[0m\\n'
                            echo "$RC_CONTENT" > openrc.sh
                            chmod +x openrc.sh

                            # Загружаем переменные окружения
                            . ./openrc.sh

                            # 🔍 Отладка: проверяем ключевые переменные (POSIX-совместимо)
                            printf '\\033[90m🔍 Verifying required variables...\\033[0m\\n'
                            for var in OS_AUTH_URL OS_USERNAME OS_PASSWORD OS_PROJECT_NAME; do
                                val=$(eval echo \\$$var)
                                if [ -z "$val" ]; then
                                    printf '\\033[31m❌ %s is NOT set\\033[0m\\n' "$var"
                                    exit 1
                                else
                                    printf '\\033[32m✅ %s is set\\033[0m\\n' "$var"
                                fi
                            done

                            printf '\\033[35m🔑 Testing OpenStack connection...\\033[0m\\n'
                            openstack token issue -f yaml
                            printf '\\033[32m✅ Auth successful\\033[0m\\n'
                        '''
                    }
                }
            }
        }
        
        stage('Validate Template') {
            steps {
                ansiColor('xterm') {
                    withCredentials([string(credentialsId: OS_CREDENTIALS_ID, variable: 'RC_CONTENT')]) {
                        sh '''
                            set -eu
                            . ./openrc.sh

                            printf '\\033[35m📋 Validating Heat template...\\033[0m\\n'
                            openstack orchestration template validate -t ${HEAT_TEMPLATE}
                            printf '\\033[32m✅ Template is valid\\033[0m\\n'
                        '''
                    }
                }
            }
        }
        
        stage('Check & Cleanup Existing Infra') {
            steps {
                ansiColor('xterm') {
                    withCredentials([string(credentialsId: OS_CREDENTIALS_ID, variable: 'RC_CONTENT')]) {
                        script {
                            echo "🔍 Checking if stack '${HEAT_STACK_NAME}' exists..."
                            
                            def stackExists = sh(
                                script: """
                                    set -eu
                                    . ./openrc.sh
                                    openstack stack show ${HEAT_STACK_NAME} -f value -c stack_status 2>/dev/null || echo 'NOT_FOUND'
                                """,
                                returnStdout: true
                            ).trim()
                            
                            if (stackExists == 'NOT_FOUND') {
                                echo "✅ Stack '${HEAT_STACK_NAME}' does not exist. Proceeding."
                            } else {
                                sh "printf '\\033[33m⚠️ Stack exists with status: ${stackExists}\\033[0m\\n'"
                                sh "printf '\\033[31m🗑️ Deleting existing stack...\\033[0m\\n'"
                                
                                sh '''
                                    set -eu
                                    . ./openrc.sh
                                    openstack stack delete --yes ${HEAT_STACK_NAME}
                                    
                                    printf '\\033[35m⏳ Waiting for deletion...\\033[0m\\n'
                                    while openstack stack show ${HEAT_STACK_NAME} -f value -c stack_status 2>/dev/null | grep -q .; do
                                        printf '  \\033[90mStill deleting... (sleep 5s)\\033[0m\\n'
                                        sleep 5
                                    done
                                    printf '\\033[32m✅ Stack deleted\\033[0m\\n'
                                '''
                            }
                        }
                    }
                }
            }
        }
        
        stage('Deploy Infrastructure') {
            steps {
                ansiColor('xterm') {
                    withCredentials([string(credentialsId: OS_CREDENTIALS_ID, variable: 'RC_CONTENT')]) {
                        sh '''
                            set -eu
                            . ./openrc.sh

                            printf '\\033[35m🚀 Creating stack: %s...\\033[0m\\n' "${HEAT_STACK_NAME}"

                            openstack stack create \\
                                -t ${HEAT_TEMPLATE} \\
                                --parameter existing_subnet_id=${EXISTING_SUBNET_ID} \\
                                --parameter jenkins_build_id=${BUILD_NUMBER} \\
                                --parameter key_name=${SSH_KEY_NAME} \\
                                --wait \\
                                ${HEAT_STACK_NAME}

                            printf '\\033[32m✅ Stack created successfully!\\033[0m\\n'
                        '''
                    }
                }
            }
        }
        
        stage('Collect Outputs') {
            steps {
                ansiColor('xterm') {
                    withCredentials([string(credentialsId: OS_CREDENTIALS_ID, variable: 'RC_CONTENT')]) {
                        script {
                            echo "📥 Collecting stack outputs..."
                            
                            env.SERVER_IP = sh(
                                script: """
                                    set -eu
                                    . ./openrc.sh
                                    openstack stack output show -c output_value -f value ${HEAT_STACK_NAME} server_public_ip
                                """,
                                returnStdout: true
                            ).trim()
                            
                            sh "printf '\\033[32m🌍 Infrastructure ready at: \\033[36m%s\\033[0m\\n' '${env.SERVER_IP}'"
                            
                            sh '''
                                set -eu
                                . ./openrc.sh
                                openstack stack output show ${HEAT_STACK_NAME} > stack_outputs.txt
                            '''
                            echo "✅ Outputs saved"
                        }
                    }
                }
            }
        }
    }
    
    post {
        always {
            ansiColor('xterm') {
                echo "📦 Archiving artifacts..."
                archiveArtifacts artifacts: 'stack_outputs.txt', allowEmptyArchive: true
                cleanWs()
            }
        }
        failure {
            ansiColor('xterm') {
                sh "printf '\\033[31m❌ DEPLOYMENT FAILED\\033[0m\\n'"
                sh "printf '\\033[31m🔍 Check OpenStack dashboard for details\\033[0m\\n'"
                withCredentials([string(credentialsId: OS_CREDENTIALS_ID, variable: 'RC_CONTENT')]) {
                    sh '''
                        set -eu
                        . ./openrc.sh
                        if openstack stack show ${HEAT_STACK_NAME} &>/dev/null; then
                            printf '\\033[33m🗑️ Cleaning up failed stack...\\033[0m\\n'
                            openstack stack delete --yes ${HEAT_STACK_NAME}
                        fi
                    '''
                }
            }
        }
        success {
            ansiColor('xterm') {
                sh "printf '\\033[32m🎉 SUCCESS: Infrastructure deployed!\\033[0m\\n'"
                sh "printf '\\033[36m🔐 SSH: \\033[0mssh ubuntu@%s\\n' '${env.SERVER_IP}'"
            }
        }
    }
}
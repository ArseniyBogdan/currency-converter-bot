pipeline {
    agent {
        label 'arseniy-agent' 
    }
    
    environment {
        OS_CREDENTIALS_ID = 'rc-credentials-arseniy'
        HEAT_STACK_NAME = "currency-converter-bot-infra"
        HEAT_TEMPLATE = 'heat/deploy-infra.yaml'

            // === Параметры Heat-шаблона ===
        OS_IMAGE_ID = 'ubuntu-22.04'                    // ⚠️ Исправлено: было "ununtu"
        OS_FLAVOR_ID = 'm1.small'
        SSH_KEY_NAME = 'jenkins-key'
        EXISTING_SUBNET_ID = 'd80da048-c188-45a5-80e4-55d914fe58ea'
        PUBLIC_NETWORK_ID = '17eae9b6-2168-4a07-a0d3-66d5ad2a9f0e'
    }
    
    stages {
        stage('Checkout') {
            steps {    
                ansiColor('xterm') {            
                    printStageHeader('Checkout', '📦', 32)
                    checkout scm
                }
            }
        }
        
        stage('Prepare OpenStack Env') {
            steps {
                ansiColor('xterm') {
                    sh 'echo -e "\\e[36m🔐 Loading OpenStack credentials...\\e[0m"'
                    loadSecretsIntoEnv("${OS_CREDENTIALS_ID}")
                    sh '''           
                        echo -e "\\e[35m🔑 Testing OpenStack connection...\\e[0m"

                        openstack token issue -f yaml
                        echo -e "\\e[32m✅ Auth successful\\e[0m"
                    '''
                    
                }
            }
        }
        
        stage('Check & Cleanup Existing Infra') {
            steps {
                ansiColor('xterm') {
                    printStageHeader('Check & Cleanup', '🧹', 32)
                    script {
                        echo "🔍 Checking if stack '${HEAT_STACK_NAME}' exists..."
                        
                        def stackExists = sh(
                            script: "openstack stack show ${HEAT_STACK_NAME} -f value -c stack_status 2>/dev/null || echo 'NOT_FOUND'",
                            returnStdout: true
                        ).trim()
                        
                        if (stackExists == 'NOT_FOUND') {
                            echo "✅ Stack '${HEAT_STACK_NAME}' does not exist. Proceeding."
                        } else {
                            sh "echo -e '\\e[33m⚠️ Stack exists with status: ${stackExists}\\e[0m'"
                            sh "echo -e '\\e[31m🗑️ Deleting existing stack...\\e[0m'"
                            
                            sh '''
                                openstack stack delete --yes ${HEAT_STACK_NAME}
                                
                                echo -e "\\e[35m⏳ Waiting for deletion...\\e[0m"
                                while openstack stack show ${HEAT_STACK_NAME} -f value -c stack_status 2>/dev/null | grep -q .; do
                                    echo -e "  \\e[90mStill deleting... (sleep 5s)\\e[0m"
                                    sleep 5
                                done
                                echo -e "\\e[32m✅ Stack deleted\\e[0m"
                            '''
                        }
                    }
                }
            }
        }
        
        stage('Deploy Infrastructure') {
            steps {
                ansiColor('xterm') {
                    printStageHeader('Deploy Infrastructure', '🚀', 35) // magenta
                    sh '''
                        echo -e "\\e[35m📦 Creating stack: ${HEAT_STACK_NAME}...\\e[0m"
                        echo -e "\\e[90m   Template: ${HEAT_TEMPLATE}\\e[0m"
                        echo -e "\\e[90m   Image: ${OS_IMAGE_ID}\\e[0m"
                        echo -e "\\e[90m   Flavor: ${OS_FLAVOR_ID}\\e[0m"
                        echo -e "\\e[90m   Key: ${SSH_KEY_NAME}\\e[0m"
                        
                        openstack stack create \
                            -t ${HEAT_TEMPLATE} \
                            --parameter image_id=${OS_IMAGE_ID} \
                            --parameter flavor_id=${OS_FLAVOR_ID} \
                            --parameter key_name=${SSH_KEY_NAME} \
                            --parameter existing_subnet_id=${EXISTING_SUBNET_ID} \
                            --parameter public_network=${PUBLIC_NETWORK_ID} \
                            --wait \
                            ${HEAT_STACK_NAME}
                            
                        echo -e "\\e[32m✅ Stack created successfully!\\e[0m"
                    '''
                }
            }
        }
        
        stage('Collect Outputs') {
            steps {
                ansiColor('xterm') {
                    printStageHeader('Collect Outputs', '📥', 32) 
                    script {
                        echo "📥 Collecting stack outputs..."
                        
                        env.SERVER_IP = sh(
                            script: "openstack stack output show -c output_value -f value ${HEAT_STACK_NAME} server_public_ip",
                            returnStdout: true
                        ).trim()

                        sh "echo -e '\\e[32m🌍 Infrastructure ready at: \\e[36m${env.SERVER_IP}\\e[0m'"
                        
                        sh "openstack stack output show ${HEAT_STACK_NAME} > stack_outputs.txt"
                        echo "✅ Outputs saved to stack_outputs.txt"
                    }
                }
            }
        }
    }
    
    post {
        always {
            ansiColor('xterm') {
                script {
                    printStageHeader('Post Actions', '📦', 32)
                }
                echo "🗃️ Archiving artifacts..."
                archiveArtifacts artifacts: 'stack_outputs.txt', allowEmptyArchive: true
                echo "🧹 Cleaning workspace..."
                cleanWs()
            }
        }
        failure {
            ansiColor('xterm') {
                script {
                    printStageHeader('❌ FAILURE', '💥', 31) // red
                }
                sh "echo -e '\\e[31m❌ DEPLOYMENT FAILED\\e[0m'"
                sh "echo -e '\\e[31m🔍 Check OpenStack dashboard for details\\e[0m'"
                sh '''
                    if openstack stack show ${HEAT_STACK_NAME} &>/dev/null; then
                        echo -e "\\e[33m🗑️ Cleaning up failed stack...\\e[0m"
                        openstack stack delete --yes ${HEAT_STACK_NAME} || true
                    fi
                '''
            }
        }
        success {
            ansiColor('xterm') {
                script {
                    printStageHeader('🎉 SUCCESS', '✨', 32) // green
                }
                sh "echo -e '\\e[32m🎉 Infrastructure deployed successfully!\\e[0m'"
                sh "echo -e '\\e[36m🔐 SSH: \\e[1mssh ubuntu@${env.SERVER_IP}\\e[0m'"
            }
        }
    }
}

// ============================================================================
// HELPER FUNCTIONS
// ============================================================================

def printStageHeader(String stageName, String emoji = '', int colorCode = 36) {
    def border = "=" * 22
    def bold = "\\e[1m"
    def color = "\\e[${colorCode}m"
    def reset = "\\e[0m"
    def display = emoji ? "${emoji} ${stageName}" : stageName

    sh(script: "echo -e '${bold}${color}${border} ${display} ${border}${reset}'", returnStdout: false)
}

def loadSecretsIntoEnv(String credentialId) {
    withCredentials([string(credentialsId: credentialId, variable: 'SECRET_BLOB')]) {
        def content = SECRET_BLOB
        
        content.split(' ').each { rawLine ->
            try {
                def line = rawLine.trim()
                if (!line || line.startsWith('#')) return
                
                def parts = line.split('=', 2)
                if (parts.length != 2) return
                
                def key = parts[0].trim()
                def value = parts[1].trim()
                
                // Удаляем кавычки по краям
                while (value.length() >= 2 && 
                      ((value.startsWith('"') && value.endsWith('"')) || 
                       (value.startsWith("'") && value.endsWith("'")))) {
                    value = value.substring(1, value.length() - 1)
                }
                value = value.trim()
                
                env."${key}" = value
                println "✅ Loaded: ${key}"
                
            } catch (Exception e) {
                println "❌ Error loading ${key ?: 'unknown'}: ${e.message}"
            }
        }
    }
}
pipeline {
    agent {
        label 'arseniy-agent' 
    }

    options {
        // ✅ Включаем поддержку ANSI-цветов для всего пайплайна
        ansiColor('xterm')
    }
    
    environment {
        OS_CREDENTIALS_ID = 'rc-credentials-arseniy'
        HEAT_STACK_NAME = "currency-converter-bot-infra"
        HEAT_TEMPLATE = 'heat/deploy-infra.yaml'
    }
    
    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }
        
        stage('Prepare OpenStack Env') {
            steps {
                ansiColor('xterm') {
                    withCredentials([string(credentialsId: OS_CREDENTIALS_ID, variable: 'RC_CONTENT')]) {
                        sh '''
                            #!/bin/bash
                            set -euo pipefail
                            
                            echo -e "\\e[36m🔐 Loading OpenStack credentials...\\e[0m"
                            echo "$RC_CONTENT" > openrc.sh
                            chmod +x openrc.sh
                            
                            # Загружаем переменные окружения
                            . ./openrc.sh
                            
                            # 🔍 Отладка: проверяем ключевые переменные
                            echo -e "\\e[90m🔍 Verifying required variables...\\e[0m"
                            for var in OS_AUTH_URL OS_USERNAME OS_PASSWORD OS_PROJECT_NAME; do
                                if [ -z "${!var:-}" ]; then
                                    echo -e "\\e[31m❌ $var is NOT set\\e[0m"
                                    exit 1
                                else
                                    echo -e "\\e[32m✅ $var is set\\e[0m"
                                fi
                            done
                            
                            echo -e "\\e[35m🔑 Testing OpenStack connection...\\e[0m"
                            openstack token issue -f yaml
                            echo -e "\\e[32m✅ Auth successful\\e[0m"
                        '''
                    }
                }
            }
        }
        
        stage('Validate Template') {
            steps {
                ansiColor('xterm') {
                    withCredentials([string(credentialsId: OS_CREDENTIALS_ID, variable: 'RC_CONTENT')]) {
                        sh '''
                            #!/bin/bash
                            set -euo pipefail
                            
                            . ./openrc.sh
                            
                            echo -e "\\e[35m📋 Validating Heat template...\\e[0m"
                            openstack orchestration template validate -t ${HEAT_TEMPLATE}
                            echo -e "\\e[32m✅ Template is valid\\e[0m"
                        '''
                    }
                }
            }
        }
        
        stage('Check & Cleanup Existing Infra') {
            steps {
                ansiColor('xterm') {
                    withCredentials([string(credentialsId: OS_CREDENTIALS_ID, variable: 'RC_CONTENT')]) {
                        script {
                            echo "🔍 Checking if stack '${HEAT_STACK_NAME}' exists..."
                            
                            def stackExists = sh(
                                script: """
                                    #!/bin/bash
                                    set -euo pipefail
                                    . ./openrc.sh
                                    openstack stack show ${HEAT_STACK_NAME} -f value -c stack_status 2>/dev/null || echo 'NOT_FOUND'
                                """,
                                returnStdout: true
                            ).trim()
                            
                            if (stackExists == 'NOT_FOUND') {
                                echo "✅ Stack '${HEAT_STACK_NAME}' does not exist. Proceeding."
                            } else {
                                sh "echo -e '\\e[33m⚠️ Stack exists with status: ${stackExists}\\e[0m'"
                                sh "echo -e '\\e[31m🗑️ Deleting existing stack...\\e[0m'"
                                
                                sh '''
                                    #!/bin/bash
                                    set -euo pipefail
                                    . ./openrc.sh
                                    openstack stack delete --yes ${HEAT_STACK_NAME}
                                    
                                    echo -e "\\e[35m⏳ Waiting for deletion...\\e[0m"
                                    while openstack stack show ${HEAT_STACK_NAME} -f value -c stack_status 2>/dev/null | grep -q .; do
                                        echo -e "  \\e[90mStill deleting... (sleep 5s)\\e[0m"
                                        sleep 5
                                    done
                                    echo -e "\\e[32m✅ Stack deleted\\e[0m"
                                '''
                            }
                        }
                    }
                }
            }
        }
        
        stage('Deploy Infrastructure') {
            steps {
                ansiColor('xterm') {
                    withCredentials([string(credentialsId: OS_CREDENTIALS_ID, variable: 'RC_CONTENT')]) {
                        sh '''
                            #!/bin/bash
                            set -euo pipefail
                            
                            . ./openrc.sh
                            
                            echo -e "\\e[35m🚀 Creating stack: ${HEAT_STACK_NAME}...\\e[0m"
                            
                            openstack stack create \
                                -t ${HEAT_TEMPLATE} \
                                --parameter existing_subnet_id=${EXISTING_SUBNET_ID} \
                                --parameter jenkins_build_id=${BUILD_NUMBER} \
                                --parameter key_name=${SSH_KEY_NAME} \
                                --wait \
                                ${HEAT_STACK_NAME}
                                
                            echo -e "\\e[32m✅ Stack created successfully!\\e[0m"
                        '''
                    }
                }
            }
        }
        
        stage('Collect Outputs') {
            steps {
                ansiColor('xterm') {
                    withCredentials([string(credentialsId: OS_CREDENTIALS_ID, variable: 'RC_CONTENT')]) {
                        script {
                            echo "📥 Collecting stack outputs..."
                            
                            env.SERVER_IP = sh(
                                script: """
                                    #!/bin/bash
                                    set -euo pipefail
                                    . ./openrc.sh
                                    openstack stack output show -c output_value -f value ${HEAT_STACK_NAME} server_public_ip
                                """,
                                returnStdout: true
                            ).trim()
                            
                            sh "echo -e '\\e[32m🌍 Infrastructure ready at: \\e[36m${env.SERVER_IP}\\e[0m'"
                            
                            sh '''
                                #!/bin/bash
                                set -euo pipefail
                                . ./openrc.sh
                                openstack stack output show ${HEAT_STACK_NAME} > stack_outputs.txt
                            '''
                            echo "✅ Outputs saved"
                        }
                    }
                }
            }
        }
    }
    
    post {
        always {
            ansiColor('xterm') {
                echo "📦 Archiving artifacts..."
                archiveArtifacts artifacts: 'stack_outputs.txt', allowEmptyArchive: true
                cleanWs()
            }
        }
        failure {
            ansiColor('xterm') {
                sh "echo -e '\\e[31m❌ DEPLOYMENT FAILED\\e[0m'"
                sh "echo -e '\\e[31m🔍 Check OpenStack dashboard for details\\e[0m'"
                withCredentials([string(credentialsId: OS_CREDENTIALS_ID, variable: 'RC_CONTENT')]) {
                    sh '''
                        #!/bin/bash
                        set -euo pipefail
                        . ./openrc.sh
                        if openstack stack show ${HEAT_STACK_NAME} &>/dev/null; then
                            echo -e "\\e[33m🗑️ Cleaning up failed stack...\\e[0m"
                            openstack stack delete --yes ${HEAT_STACK_NAME}
                        fi
                    '''
                }
            }
        }
        success {
            ansiColor('xterm') {
                sh "echo -e '\\e[32m🎉 SUCCESS: Infrastructure deployed!\\e[0m'"
                sh "echo -e '\\e[36m🔐 SSH: \\e[0mssh ubuntu@${env.SERVER_IP}'"
            }
        }
    }
}
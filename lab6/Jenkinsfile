pipeline {
    agent none  // ← не используем агента по умолчанию

    environment {
        TF_DIR = 'lab6/terraform'
        ANSIBLE_DIR = 'lab6/ansible'
        GEN_INV_SCRIPT = "${ANSIBLE_DIR}/generate_inventory.sh"
        INVENTORY_FILE = "${ANSIBLE_DIR}/inventory.yml"
    }

    stages {
        stage('Checkout') {
            agent any  // ← для checkout нужен любой агент
            steps {
                echo '📥 Checking out...'
                checkout scm
                stash includes: 'lab6/**', name: 'lab6-code'
            }
        }

        stage('Terraform Apply') {
            agent {
                docker {
                    image 'hashicorp/terraform:latest'
                    args '-v /var/run/docker.sock:/var/run/docker.sock -u root'
                }
            }
            steps {
                unstash 'lab6-code'
                dir("${TF_DIR}") {
                    withCredentials([string(credentialsId: 'yc-token', variable: 'YC_TOKEN')]) {
                        sh '''
                            export YC_TOKEN=${YC_TOKEN}
                            terraform init -input=false
                            terraform apply -auto-approve -input=false
                            terraform output -json > ../terraform_outputs.json || true
                        '''
                    }
                }
            }
        }

        stage('Generate Inventory') {
            agent any
            steps {
                unstash 'lab6-code'
                echo '📝 Generating inventory...'
                sh """
                    chmod +x ${GEN_INV_SCRIPT}
                    cd ${TF_DIR} && terraform output -json > ../terraform_outputs.json || true
                    cd .. && ${GEN_INV_SCRIPT}
                    cat ${INVENTORY_FILE}
                """
            }
        }

        stage('Ansible Playbook') {
            agent {
                docker {
                    image 'ansible/ansible:latest'
                    args '-v /var/run/docker.sock:/var/run/docker.sock -u root'
                }
            }
            steps {
                unstash 'lab6-code'
                dir("${ANSIBLE_DIR}") {
                    withCredentials([string(credentialsId: 'bot-token', variable: 'BOT_TOKEN')]) {
                        sh '''
                            ansible-playbook -i inventory.yml playbook.yml \
                                --extra-vars "bot_token=${BOT_TOKEN}" -v
                        '''
                    }
                }
            }
        }

        stage('Ansible Deploy') {
            agent {
                docker {
                    image 'ansible/ansible:latest'
                    args '-v /var/run/docker.sock:/var/run/docker.sock -u root'
                }
            }
            steps {
                unstash 'lab6-code'
                dir("${ANSIBLE_DIR}") {
                    sh '''
                        ansible-playbook -i inventory.yml deploy.yml -v
                    '''
                }
            }
        }

        stage('Verify') {
            agent any
            steps {
                script {
                    def vmIP = sh(
                        script: "grep ansible_host ${INVENTORY_FILE} | awk '{print \$2}'",
                        returnStdout: true
                    ).trim()
                    echo "🎯 VM IP: ${vmIP}"

                    sshagent(credentials: ['vm-ssh-key']) {
                        sh """
                            ssh -o StrictHostKeyChecking=no ubuntu@${vmIP} "sudo systemctl is-active currency-bot"
                        """
                    }
                }
            }
        }
    }

    post {
        success {
            echo '🎉 Success!'
        }
        failure {
            echo '❌ Failed!'
        }
        always {
            cleanWs()
        }
    }
}
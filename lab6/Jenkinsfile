pipeline {
    agent any  // ← один агент для всех стадий

    environment {
        TF_DIR = 'lab6/terraform'
        ANSIBLE_DIR = 'lab6/ansible'
        GEN_INV_SCRIPT = "${ANSIBLE_DIR}/generate_inventory.sh"
        INVENTORY_FILE = "${ANSIBLE_DIR}/inventory.yml"
    }

    stages {
        stage('Checkout') {
            steps {
                echo '📥 Checking out...'
                checkout scm
            }
        }

        stage('Terraform Apply') {
            steps {
                echo '☁️ Managing infrastructure...'
                dir("${TF_DIR}") {
                    withCredentials([
                        string(credentialsId: 'yc-token', variable: 'YC_TOKEN'),
                        string(credentialsId: 'ssh-public-key', variable: 'SSH_PUBLIC_KEY')
                    ]) {
                        sh '''
                            export YC_TOKEN=${YC_TOKEN}

                            # Читаем SSH ключ, если не передан
                            if [ -z "${SSH_PUBLIC_KEY}" ]; then
                                if [ -f ~/.ssh/id_rsa.pub ]; then
                                    SSH_PUBLIC_KEY=$(cat ~/.ssh/id_rsa.pub)
                                elif [ -f /var/jenkins_home/.ssh/id_rsa.pub ]; then
                                    SSH_PUBLIC_KEY=$(cat /var/jenkins_home/.ssh/id_rsa.pub)
                                else
                                    echo "❌ SSH public key not found!"
                                    exit 1
                                fi
                            fi

                            # 🔥 ИНИЦИАЛИЗАЦИЯ
                            terraform init -input=false

                            # 🔥 СНАЧАЛА УДАЛЯЕМ СТАРОЕ (если есть)
                            echo '🗑️ Destroying existing resources (if any)...'
                            terraform destroy -auto-approve -input=false \
                                -var "ssh_public_key=${SSH_PUBLIC_KEY}" || true

                            # 🔥 ПОТОМ СОЗДАЁМ НОВОЕ
                            echo '✨ Creating new infrastructure...'
                            terraform apply -auto-approve -input=false \
                                -var "ssh_public_key=${SSH_PUBLIC_KEY}"

                            # Сохраняем output для Ansible
                            terraform output -json > ../terraform_outputs.json || true
                        '''
                    }
                }
            }
        }

        stage('Generate Inventory') {
            steps {
                echo '📝 Generating inventory...'
                sh """
                    # Используем абсолютные пути от корня workspace
                    chmod +x \${WORKSPACE}/${GEN_INV_SCRIPT}

                    # Генерируем output из Terraform (абсолютный путь)
                    \${WORKSPACE}/${TF_DIR}/terraform output -json > \${WORKSPACE}/terraform_outputs.json || true

                    # Запускаем скрипт, передавая ему пути как аргументы (опционально)
                    # Или просто запускаем из правильной директории:
                    cd \${WORKSPACE}/${ANSIBLE_DIR}
                    ./generate_inventory.sh

                    # Показываем результат
                    cat \${WORKSPACE}/${INVENTORY_FILE}
                """
            }
        }

        stage('Ansible Playbook') {
            steps {
                echo '🏗 Running playbook...'
                dir("${ANSIBLE_DIR}") {
                    withCredentials([string(credentialsId: 'bot-token', variable: 'BOT_TOKEN')]) {
                        sh '''
                            ansible-playbook -i inventory.yml playbook.yml \
                                --extra-vars "bot_token=${BOT_TOKEN}" -v
                        '''
                    }
                }
            }
        }

        stage('Ansible Deploy') {
            steps {
                echo '🚀 Deploying app...'
                dir("${ANSIBLE_DIR}") {
                    sh '''
                        ansible-playbook -i inventory.yml deploy.yml -v
                    '''
                }
            }
        }

        stage('Verify') {
            steps {
                script {
                    def vmIP = sh(
                        script: "grep ansible_host ${INVENTORY_FILE} | awk '{print \$2}'",
                        returnStdout: true
                    ).trim()
                    echo "🎯 VM IP: ${vmIP}"

                    sshagent(credentials: ['vm-ssh-key']) {
                        sh """
                            ssh -o StrictHostKeyChecking=no ubuntu@${vmIP} "sudo systemctl is-active currency-bot"
                        """
                    }
                }
            }
        }
    }

        post {
            success {
                echo '🎉 Pipeline completed successfully!'
            }
            failure {
                echo '❌ Pipeline failed. Check console output.'
            }
            always {
                // ✅ Чистим только временные файлы, но сохраняем state!
                sh '''
                    rm -rf lab6/terraform/.terraform/providers
                    rm -f lab6/terraform/.terraform.lock.hcl
                    # terraform.tfstate и .terraform/state/ НЕ трогаем!
                '''
            }
        }
}
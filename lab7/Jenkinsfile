pipeline {
    agent any

    environment {
        APP_NAME = 'currency-converter-bot'
        APP_VERSION = '0.0'
        DOCKER_IMAGE = "${APP_NAME}:latest"
        K8S_DIR = 'lab7/k8s'
        VAULT_TOKEN = 'test-token'
        // Пути к инструментам внутри контейнера
        DOCKER_CLI = '/tmp/docker'
        KUBECTL_CLI = '/tmp/kubectl'
        KUBE_CONFIG = '/tmp/kubeconfig'
    }

    stages {
        stage('Setup Linux Tools') {
            steps {
                echo '🔧 Installing Linux Docker CLI and kubectl...'
                script {
                    // 1. Скачиваем Docker CLI для Linux (статический бинарник)
                    sh '''
                        if [ ! -f ${DOCKER_CLI} ]; then
                            echo "⬇️ Downloading Docker CLI for Linux..."
                            curl -fsSL https://download.docker.com/linux/static/stable/x86_64/docker-24.0.7.tgz | tar -xz -C /tmp --strip-components=1 docker/docker
                            chmod +x ${DOCKER_CLI}
                            ${DOCKER_CLI} --version
                        fi
                    '''

                    // 2. Скачиваем kubectl для Linux
                    sh '''
                        if [ ! -f ${KUBECTL_CLI} ]; then
                            echo "⬇️ Downloading kubectl for Linux..."
                            curl -LO "https://dl.k8s.io/release/$(curl -s https://dl.k8s.io/release/stable.txt)/bin/linux/amd64/kubectl"
                            chmod +x kubectl
                            mv kubectl ${KUBECTL_CLI}
                            ${KUBECTL_CLI} version --client
                        fi
                    '''

                    // 3. Копируем и чиним kube config (важно для Docker Desktop K8s)
                    sh '''
                        if [ -f /var/jenkins_home/.kube/config ]; then
                            echo "🔐 Fixing kubeconfig paths..."
                            cp /var/jenkins_home/.kube/config ${KUBE_CONFIG}
                            # Заменяем абсолютные пути на сертификаты (если есть)
                            # Для Docker Desktop K8s обычно не требуется, но на всякий случай
                            sed -i 's|/Users/[^/]*/||g' ${KUBE_CONFIG} 2>/dev/null || true
                            sed -i 's|/home/[^/]*/||g' ${KUBE_CONFIG} 2>/dev/null || true
                        else
                            echo "⚠️ No kubeconfig found, using default"
                            export KUBECONFIG=""
                        fi
                    '''
                }
            }
        }

        stage('Checkout') {
            steps {
                echo '📥 Checking out source code...'
                checkout scm
            }
        }

        stage('Build FatJar') {
            steps {
                echo '🔨 Building fatJar...'
                sh '''
                    chmod +x gradlew
                    ./gradlew clean fatJar -x test --no-daemon \
                      -Dorg.gradle.internal.http.connectionTimeout=120000 \
                      -Dorg.gradle.internal.http.socketTimeout=120000
                '''
            }
        }

        stage('Build Docker Image') {
            steps {
                echo '🐳 Building Docker image...'
                // Используем скачанный Docker CLI
                sh "${DOCKER_CLI} build -t ${DOCKER_IMAGE} ."
            }
        }

        stage('Inject Vault Secrets') {
            steps {
                echo '🔐 Writing secrets to Vault...'
                script {
                    try {
                        // Используем скачанный kubectl с исправленным конфигом
                        sh "KUBECONFIG=${KUBE_CONFIG} ${KUBECTL_CLI} port-forward svc/vault 8200:8200 > /dev/null 2>&1 &"
                        sh 'sleep 4'

                        sh """
                            curl -s -X POST \\
                              http://localhost:8200/v1/secret/data/${APP_NAME} \\
                              -H "X-Vault-Token: ${VAULT_TOKEN}" \\
                              -H "Content-Type: application/json" \\
                              -d '{
                                "data": {
                                  "mongo_uri": "mongodb://test:test@mongodb:27017/currency-bot?authSource=admin",
                                  "mongo_username": "test",
                                  "mongo_password": "test",
                                  "rabbitmq_host": "rabbitmq",
                                  "rabbitmq_username": "test",
                                  "rabbitmq_password": "test",
                                  "bot_token": "8312519972:AAGrLasXJtoR0HNY5Pa0WLikJkzOtv7s5gE"
                                }
                              }'
                        """
                    } finally {
                        sh 'pkill -f "kubectl port-forward" || true'
                    }
                }
            }
        }

        stage('Deploy Infrastructure & App') {
            steps {
                echo '☸️ Applying Kubernetes manifests...'
                sh "KUBECONFIG=${KUBE_CONFIG} ${KUBECTL_CLI} apply -f ${K8S_DIR}/mongodb.yaml"
                sh "KUBECONFIG=${KUBE_CONFIG} ${KUBECTL_CLI} apply -f ${K8S_DIR}/rabbitmq.yaml"
                sh "KUBECONFIG=${KUBE_CONFIG} ${KUBECTL_CLI} apply -f ${K8S_DIR}/vault.yaml"
                sh "KUBECONFIG=${KUBE_CONFIG} ${KUBECTL_CLI} apply -f ${K8S_DIR}/configmap.yaml"
                sh "KUBECONFIG=${KUBE_CONFIG} ${KUBECTL_CLI} apply -f ${K8S_DIR}/deployment.yaml"
                sh "KUBECONFIG=${KUBE_CONFIG} ${KUBECTL_CLI} apply -f ${K8S_DIR}/service.yaml"
            }
        }

        stage('Wait & Verify') {
            steps {
                echo '⏳ Waiting for pods to be ready...'
                sh "KUBECONFIG=${KUBE_CONFIG} ${KUBECTL_CLI} wait --for=condition=ready pod -l app=mongodb --timeout=60s || true"
                sh "KUBECONFIG=${KUBE_CONFIG} ${KUBECTL_CLI} wait --for=condition=ready pod -l app=rabbitmq --timeout=60s || true"
                sh "KUBECONFIG=${KUBE_CONFIG} ${KUBECTL_CLI} wait --for=condition=ready pod -l app=vault --timeout=60s || true"
                sh "KUBECONFIG=${KUBE_CONFIG} ${KUBECTL_CLI} wait --for=condition=ready pod -l app=${APP_NAME} --timeout=180s || echo '⚠️ App pod may still be starting'"

                echo '📊 Current status:'
                sh "KUBECONFIG=${KUBE_CONFIG} ${KUBECTL_CLI} get pods"
                echo '🚀 Pipeline finished. Check bot in Telegram!'
            }
        }
    }

    post {
        always {
            echo '🧹 Cleaning workspace...'
            cleanWs()
            sh 'pkill -f "kubectl port-forward" || true'
        }
        success {
            echo '🟢 PIPELINE SUCCESS! Bot should be running.'
        }
        failure {
            echo '🔴 PIPELINE FAILED. Debug commands:'
            sh "KUBECONFIG=${KUBE_CONFIG} ${KUBECTL_CLI} get pods || true"
            sh "KUBECONFIG=${KUBE_CONFIG} ${KUBECTL_CLI} logs -l app=currency-bot --tail=30 || true"
        }
    }
}